      "seed": 125525554,
      "version": 916,
      "versionNonce": 437511538,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790081193724,
      "created": 1790072607143,
      "link": null,
      "locked": false,
      "text": "API Design \n\napi appended with /api/v1/\n\n// the user can order a \nPOST /order -> Partial<order>\n{\n    \"idemptency key\" : \"key\",\n    \"product-id\" : \"325\",\n    \"quantity\": \"4\"\n    \n}\n\n// the user can make a payment\nPOST /payment/order-id \n\n// the user shall get order status\nGET /order/order-id/status \n\n// user can browse products\nGET /products \n\n// user can search products\nGET /products/search?q= \n\n// get fleet latest data\nGET /fleet \n\n// get order status\nGET /order/:order-id/status\n\n\n// service interact with robots\n/robots/upgrade\nsocket()\n\n/robots",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API Design \n\napi appended with /api/v1/\n\n// the user can order a \nPOST /order -> Partial<order>\n{\n    \"idemptency key\" : \"key\",\n    \"product-id\" : \"325\",\n    \"quantity\": \"4\"\n    \n}\n\n// the user can make a payment\nPOST /payment/order-id \n\n// the user shall get order status\nGET /order/order-id/status \n\n// user can browse products\nGET /products \n\n// user can search products\nGET /products/search?q= \n\n// get fleet latest data\nGET /fleet \n\n// get order status\nGET /order/:order-id/status\n\n\n// service interact with robots\n/robots/upgrade\nsocket()\n\n/robots",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
